# ---- Application ----
ENVIRONMENT=local
DEBUG=false

# ---- Database ----
# SQLite (default, zero-setup) : sqlite+aiosqlite:///./app.db
# PostgreSQL                   : postgresql+asyncpg://user:pass@localhost:5432/appdb
DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_ECHO=false
# Keep this OFF: Alembic owns the schema. Turning it on makes
# `alembic upgrade` fail with "table already exists".
AUTO_CREATE_TABLES=false

# ---- Auth ----
# Secrets must be at least 32 bytes (RFC 7518 section 3.2).
AUTH_JWT_ALG=HS256
AUTH_JWT_SECRET=dev-insecure-access-secret-change-me
AUTH_JWT_EXP_MINUTES=5
AUTH_REFRESH_TOKEN_KEY=dev-insecure-refresh-key-change-me
AUTH_REFRESH_TOKEN_EXP=30 days
AUTH_SECURE_COOKIES=true

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Pagination ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
