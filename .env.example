# ---- Application ----
ENVIRONMENT=local
DEBUG=false

# ---- Database ----
# SQLite (default, zero-setup) : sqlite+aiosqlite:///./app.db
# PostgreSQL                   : postgresql+asyncpg://user:pass@localhost:5432/appdb
DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_ECHO=false
# Keep this OFF: Alembic owns the schema. Turning it on makes
# `alembic upgrade` fail with "table already exists".
AUTO_CREATE_TABLES=false

# ---- Auth ----
# Secrets must be at least 32 bytes (RFC 7518 section 3.2).
AUTH_JWT_ALG=HS256
AUTH_JWT_SECRET=dev-insecure-access-secret-change-me
AUTH_JWT_EXP_MINUTES=5
AUTH_REFRESH_TOKEN_KEY=dev-insecure-refresh-key-change-me
AUTH_REFRESH_TOKEN_EXP=30 days
AUTH_SECURE_COOKIES=true

# ---- Permission (Casbin RBAC) ----
# Path to the Casbin model file. Empty = the one shipped in the package
# (src/permission/model.conf).
PERMISSION_MODEL_PATH=
# Run the idempotent seed on startup: default roles, default policies and the
# admin account. Turn this OFF in production once the roles are in place.
PERMISSION_SEED_ENABLED=true
# The account that receives the `admin` role when seeding.
PERMISSION_SEED_ADMIN_EMAIL=admin@example.com
# Leave empty to generate a random password on first seed (it is logged once).
PERMISSION_SEED_ADMIN_PASSWORD=
# The role that owns everything. It cannot be deleted.
PERMISSION_ADMIN_ROLE=admin

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Pagination ----
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
